{
  "name": "rebuild",
  "private": true,
  "workspaces": ["apps/api", "apps/web"],
  "engines": { "node": "24.x" },
  "scripts": {
    "dev:api": "npm run dev --workspace @rebuild/api",
    "dev:access": "npm run dev:access --workspace @rebuild/api",
    "dev:matching": "npm run dev:matching --workspace @rebuild/api",
    "db:migrate": "node --env-file-if-exists=.env db/migrate.cjs",
    "dev:web": "npm run dev --workspace @rebuild/web",
    "build": "npm run build --workspaces",
    "test": "npm test --workspace @rebuild/api"
  }
}

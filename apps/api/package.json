{
  "name": "@rebuild/api",
  "private": true,
  "scripts": {
    "dev": "node --watch --env-file-if-exists=../../.env --require ts-node/register src/main.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "test": "npm run build && node --env-file-if-exists=../../.env --test"
  },
  "dependencies": {
    "@nestjs/common": "11.2.9",
    "@nestjs/core": "11.2.9",
    "@nestjs/platform-express": "11.2.9",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "ts-node": "10.9.2",
    "typescript": "5.9.3"
  }
}
